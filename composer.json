{
    "name": "dgtlss/capsule",
    "description": "A Laravel package for backing up databases and files to external sources with notifications",
    "type": "library",
    "license": "MIT",
    "version": "3.0.0",
    "authors": [
        {
            "name": "Nathan Langer",
            "email": "nathanlanger@googlemail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "league/flysystem": "^3.0",
        "ext-zip": "*",
        "ext-sodium": "*",
        "ext-zlib": "*"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required for S3/DigitalOcean Spaces storage (^3.0)",
        "league/flysystem-ftp": "Required for FTP storage (^3.0)",
        "league/flysystem-sftp-v3": "Required for SFTP storage (^3.0)",
        "ext-sqlite3": "Required for consistent SQLite restore into a live database",
        "ext-pdo_sqlite": "Required for SQLite backup snapshots and validation"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dgtlss\\Capsule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dgtlss\\Capsule\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dgtlss\\Capsule\\CapsuleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "bin": [
        "bin/capsule-decrypt"
    ]
}
